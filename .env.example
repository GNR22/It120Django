# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file. It is listed in .gitignore.

# --- Django ---------------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- TextBee (from https://textbee.dev) -----------------------------------
TEXTBEE_API_KEY=your_textbee_api_key_here

# --- App behaviour (optional) ---------------------------------------------
# Country code assumed for numbers typed like 0917 123 4567 (63 = Philippines)
SMS_DEFAULT_COUNTRY_CODE=63
SMS_MAX_LENGTH=480
# Maximum successful submissions per day (protects your quota)
SMS_DAILY_LIMIT=20
